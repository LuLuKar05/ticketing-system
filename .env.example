# Copy to `.env` and adjust.

# Database (REQUIRED). Postgres is the only supported engine — the app fails fast at startup if
# this is unset. Start the local Postgres with `docker compose up postgres` (host port 5433).
DATABASE_URL=postgres://ticket:ticket@localhost:5433/ticketing

# HTTP
PORT=5000
# Comma-separated origins allowed to open a WebSocket connection (empty = deny all cross-origin).
CORS_ORIGINS=

# Logging
LOG_LEVEL=info          # pino level: trace|debug|info|warn|error|fatal
LOG_PRETTY=false        # true = human-readable colored logs (dev); default is JSON
DB_LOGGING=false        # true = log every SQL query (dev only)

# Rate limiting (POST /reserves). Redis is used when REDIS_URL is set AND NODE_ENV !== test;
# otherwise an in-memory limiter is used (so tests/CI need no Redis).
REDIS_URL=redis://localhost:6379
RATELIMIT_POINTS=5      # allowed requests…
RATELIMIT_DURATION=60   # …per this many seconds (rolling-counter window), per IP

# Auth — WebAuthn / passkeys. RP_ID is the site domain the passkey is bound to; RP_ORIGIN is the
# full origin the browser reports. Use 'localhost' + http://localhost:5000 for dev; the real
# HTTPS domain in prod. Redis (above) backs the single-use registration/login challenges.
RP_ID=localhost
RP_NAME=Concert Ticketing
RP_ORIGIN=http://localhost:5000

# Session (access) token — RS256. In production these are REQUIRED (the app throws without them);
# in dev an ephemeral keypair is generated if unset. Generate a PEM pair with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
# then paste them here as single lines with literal \n between the PEM lines.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ISSUER=ticketing-api        # iss claim — who minted the token
JWT_AUDIENCE=ticketing-clients  # aud claim — who the token is for
JWT_ACCESS_TTL=15m              # access-token lifetime
