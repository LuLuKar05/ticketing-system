{
    "name": "ticketing_system",
    "version": "1.0.0",
    "description": "Concert ticketing backend — hard-hold / create-on-pay reservation model with DB-enforced seat exclusivity.",
    "main": "dist/server.js",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "start": "node dist/server.js",
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "tsc",
        "test": "jest --runInBand",
        "dev": "tsc-watch --onSuccess \"node dist/server.js\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
        "migration:generate": "ts-node -T ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
        "migration:run": "ts-node -T ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
        "migration:run:prod": "typeorm migration:run -d dist/data-source.js",
        "migration:revert": "ts-node -T ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tsconfig/node26": "^26.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.4",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "jest": "^29.7.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "tsc-watch": "^7.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "@simplewebauthn/server": "^13.3.2",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "rate-limiter-flexible": "^11.2.0",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "tsyringe": "^4.10.0",
        "typeorm": "^1.0.0",
        "zod": "^4.4.3",
        "zod-openapi": "^6.0.0"
    }
}
